# Jellyfin media server (required)
JELLYFIN_URL=https://server.afduarte.co.uk/jellyfin
JELLYFIN_API_KEY=
# Optional: pin a specific Jellyfin user id. If omitted, an admin user is chosen.
# JELLYFIN_USER_ID=

# AudioMuse-AI analysis (required for BPM/key)
AUDIOMUSE_URL=https://audiomuse.server.afduarte.co.uk
AUDIOMUSE_API_KEY=
# How long a cached library snapshot is reused, in ms (default 6h)
# AUDIOMUSE_CACHE_TTL_MS=21600000
